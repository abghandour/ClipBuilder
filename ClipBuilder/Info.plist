<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist (INFOPLIST_FILE with
	     GENERATE_INFOPLIST_FILE = YES). The channel comes from the build
	     configuration's CLIPBUILDER_CHANNEL (stable or beta); AppChannel
	     reads it, a missing key means stable. -->
	<key>ClipBuilderChannel</key>
	<string>$(CLIPBUILDER_CHANNEL)</string>
</dict>
</plist>
