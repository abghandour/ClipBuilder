<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Drive token lives in the data-protection keychain, which needs a
	     keychain access group. The team prefix is written out rather than
	     $(AppIdentifierPrefix) so builds without a provisioning profile
	     (Developer ID, ad-hoc) do not produce an empty prefix. -->
	<key>keychain-access-groups</key>
	<array>
		<string>D7JTNCH58D.com.mokotti-solutions.clipbuilder</string>
	</array>
</dict>
</plist>
