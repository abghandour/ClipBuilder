// Clip Builder Beta: the same tree built as a second app that installs
// beside the stable one (docs/Stable-Beta-Channels-Plan.md). Base the
// Debug-Beta and Release-Beta configurations of the MyApp target on this
// file. It includes GoogleDrive.xcconfig, so the Info.plist (tracked
// placeholder or the ignored local one) is the same as stable's;
// Configuration/GoogleDrive-Info.plist carries
// ClipBuilderChannel = $(CLIPBUILDER_CHANNEL), and AppChannel falls back to
// the bundle id when a plist lacks the key.

#include "GoogleDrive.xcconfig"

PRODUCT_NAME = Clip Builder Beta
PRODUCT_BUNDLE_IDENTIFIER = com.mokotti-solutions.clipbuilder.beta
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Beta
INFOPLIST_KEY_CFBundleDisplayName = Clip Builder Beta
CLIPBUILDER_CHANNEL = beta
PRODUCT_MODULE_NAME = Clip_Builder
